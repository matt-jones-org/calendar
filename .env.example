# Calendar — Google Calendar / Meet booking integration
#
# Copy this file to `.env` and fill in the values from the Google Cloud Console.
# `.env` is gitignored, so your real secret never gets committed.
#
#   cp .env.example .env
#
# Create an OAuth 2.0 Client ID (type: "Web application") at:
#   https://console.cloud.google.com/apis/credentials
# and enable the Google Calendar API for the project:
#   https://console.cloud.google.com/apis/library/calendar-json.googleapis.com
#
# Add the redirect URI below to the client's "Authorized redirect URIs" list.

# --- OAuth 2.0 client (required) ---
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=paste-locally-do-not-commit
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/oauth2callback

# --- Booking target (optional) ---
# Which calendar new events are written to. "primary" = the authorizing account's
# main calendar. You can also use a specific calendar's ID.
BOOKING_CALENDAR_ID=primary

# IANA timezone used when interpreting booking times (site copy says "all times Central").
BOOKING_TIMEZONE=America/Chicago

# --- Server ---
PORT=3000
