# calendar — Google OAuth configuration
#
# Copy this file to `.env` and fill in your OAuth client credentials. `.env` is
# gitignored, so your real client secret never gets committed.
#
#   cp .env.example .env
#
# Create credentials at https://console.cloud.google.com/apis/credentials
# (an OAuth 2.0 "Web application" client), and add this app's callback URL to
# the client's "Authorized redirect URIs".

# --- Google OAuth (required) ---
# NOTE: the client secret is sensitive — put the real value only in your local
# .env, never here. This file is a committed template and must stay blank.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Callback URL Google redirects back to — must EXACTLY match an "Authorized
# redirect URI" on the OAuth client. For local dev with the built-in server:
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/auth/google/callback

# Optional. Space- or comma-separated scopes. Defaults to
# "openid email profile https://www.googleapis.com/auth/calendar.readonly"
# when unset — enough to identify the user and read their calendars. To let the
# app create bookings, add https://www.googleapis.com/auth/calendar.events.
GOOGLE_OAUTH_SCOPES=

# Port for the local server (default 8080, the Google Cloud convention).
PORT=8080
